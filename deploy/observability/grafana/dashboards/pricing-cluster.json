{
  "uid": "pricing-cluster",
  "title": "Pricing on Kubernetes",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Ready replicas by workload (KEDA scales the worker pools)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"pricing\"}",
          "legendFormat": "{{deployment}}"
        },
        {
          "refId": "B",
          "expr": "kube_statefulset_status_replicas_ready{namespace=\"pricing\"}",
          "legendFormat": "{{statefulset}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Node Ready",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"}",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Pods per node (pricing namespace)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (node) (kube_pod_info{namespace=\"pricing\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Container restarts (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"pricing\"}[5m])) > 0",
          "legendFormat": "{{pod}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Queue lag that drives KEDA",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stream) (pricing_queue_backlog{kind=\"lag\"})",
          "legendFormat": "{{stream}}"
        }
      ],
      "id": 5
    }
  ]
}