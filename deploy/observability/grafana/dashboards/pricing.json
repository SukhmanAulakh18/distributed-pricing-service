{
  "uid": "pricing",
  "title": "Pricing Service",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Cache hit ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(price_cache_total{result=~\"hit.*\"}[5m])) / sum(rate(price_cache_total[5m]))"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "/price p99 (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(price_latency_seconds_bucket[5m])))"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "HTTP 5xx ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_request_seconds_count{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_request_seconds_count[5m]))"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Intraday backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pricing_queue_backlog{stream=\"pricing:intraday\",kind=\"lag\"})"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests/s by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(http_request_seconds_count{route!~\"/metrics|/health.*\"}[1m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "/price latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(price_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(price_latency_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(price_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Cache lookups/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(price_cache_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "C++ compute time by product",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, product) (rate(price_compute_seconds_bucket[1m])))",
          "legendFormat": "p99 {{product}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le, product) (rate(price_compute_seconds_bucket[1m])))",
          "legendFormat": "p50 {{product}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Worker tasks/s by kind and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (rate(worker_tasks_total[1m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Queue backlog by stream",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stream, kind) (pricing_queue_backlog)",
          "legendFormat": "{{stream}} {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(worker_reclaimed_total[1m]))",
          "legendFormat": "reclaimed/s"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Circuit breakers (0 closed, 1 half-open, 2 open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dependency) (dependency_circuit_state)",
          "legendFormat": "{{dependency}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Admission control and price log",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(compute_rejected_total[1m]))",
          "legendFormat": "503 rejections/s"
        },
        {
          "refId": "B",
          "expr": "sum(compute_in_flight)",
          "legendFormat": "pricings in flight"
        },
        {
          "refId": "C",
          "expr": "sum(rate(price_log_dropped_rows_total[1m]))",
          "legendFormat": "log rows dropped/s"
        },
        {
          "refId": "D",
          "expr": "sum(rate(price_store_errors_total[1m]))",
          "legendFormat": "Cassandra write errors/s"
        }
      ],
      "id": 12
    }
  ]
}